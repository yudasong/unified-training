+def _pass_at_k_metrics(rewards_2d, prefix="", ks=(1, 2, 4, 8, 16)):
+    """Unbiased pass@k (Chen et al. 2021), averaged over prompts.
+
+    rewards_2d: float tensor [num_prompts, num_gen] of 0/1 correctness.
+    Returns {f"{prefix}pass@{k}": mean_pass_at_k} for each k in ks with k <= num_gen.
+    """
+    import math
+
+    out: dict[str, float] = {}
+    if rewards_2d is None or rewards_2d.ndim != 2 or rewards_2d.shape[0] == 0:
+        return out
+    n = rewards_2d.shape[1]
+    correct = rewards_2d.sum(dim=1).round().to(torch.int64).tolist()
+    for k in ks:
+        if k > n:
+            continue
+        vals = [
+            1.0 if (n - c) < k else 1.0 - math.comb(n - c, k) / math.comb(n, k)
+            for c in correct
+        ]
+        out[f"{prefix}pass@{k}"] = sum(vals) / len(vals)
+    return out
+
