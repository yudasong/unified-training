+def _validate_async_dataloader_cursor_metadata(
+    checkpoint_path: str, checkpoint_step: int
+) -> dict[str, Any]:
+    """Fail closed unless an async resume cursor has committed provenance."""
+    metadata_path = os.path.join(
+        checkpoint_path, _ASYNC_DATALOADER_CURSOR_METADATA
+    )
+    if not os.path.isfile(metadata_path):
+        raise RuntimeError(
+            "Async checkpoint is missing committed dataloader cursor metadata: "
+            f"{metadata_path}. Checkpoints written before cursor metadata existed must be "
+            "migrated before resume."
+        )
+    with open(metadata_path) as handle:
+        metadata = json.load(handle)
+
+    expected_target = checkpoint_step - 1
+    expected = {
+        "schema_version": _ASYNC_DATALOADER_CURSOR_SCHEMA_VERSION,
+        "semantics": _ASYNC_DATALOADER_CURSOR_SEMANTICS,
+        "checkpoint_step": checkpoint_step,
+        "committed_target": expected_target,
+    }
+    mismatches = {
+        key: (metadata.get(key), value)
+        for key, value in expected.items()
+        if metadata.get(key) != value
+    }
+    if mismatches:
+        raise RuntimeError(
+            "Async checkpoint has invalid committed dataloader cursor metadata: "
+            f"{mismatches}"
+        )
+    return metadata
