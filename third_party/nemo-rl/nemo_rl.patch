         return adv
+
+
+class MaxRLAdvantageEstimator:
+    """maxRL advantage estimator (Maximum Likelihood RL, arXiv:2602.02710).
+
+    Normalizes the group-relative advantage by the group MEAN instead of the std,
+    so the update approximates the maximum-likelihood policy gradient of
+    log E[reward] rather than GRPO's lower-order surrogate:
+
+      "maxrl"            A = (r - mean) / (mean + eps)
+                         For binary outcome rewards this is the exact ML policy
+                         gradient: correct -> (1 - p)/p, incorrect -> -1, where
+                         p = group pass rate = mean. All-correct (p=1) and
+                         all-wrong (p=0) groups get A = 0 (like GRPO with zero std).
+      "maxrl_offpolicy"  A = r / (mean + eps)   (= maxrl + 1, no baseline)
+                         The no-baseline form for off-policy data, where the
+                         on-policy group mean is not a valid baseline. Typically
+                         paired with loss_fn.disable_ppo_ratio=true (plain PG).
+
+    eps (maxrl_eps) doubles as a smoothing hyperparameter. At the default 1e-6 it
+    is a pure numerical guard and the formulas above hold exactly. Set larger
+    (e.g. 0.03-0.3) it softly bounds the low-pass-rate amplification instead of
+    (or alongside) the hard maxrl_clip ceiling: a correct sample's advantage
+    becomes (1 - p)/(p + eps) [maxrl] or 1/(p + eps) [maxrl_offpolicy], so a lone
+    success in a group of G is amplified by at most 1/(1/G + eps) rather than G.
+    Unlike maxrl_clip the bound is smooth in p and also shrinks mid-range
+    advantages by p/(p + eps); the negative side is scaled down by the same
+    factor rather than left untouched.
+
+    Like GRPO this is an outcome-level advantage broadcast to every response token.
+    The mean is the FULL group mean (leave_one_out_baseline=False) — the ML
+    denominator must include the sample itself, independent of
+    use_leave_one_out_baseline. maxRL normalizes by the mean, never the std.
+
+    Assumes non-negative outcome rewards (binary 0/1 here, so the group mean is in
+    [0, 1] and the (mean + eps) denominator is always positive; mean=0 => every
+    reward is 0 => A=0). A signed/near-zero group mean can blow up or sign-flip the
+    advantage — a hazard shared with the reference (offpolicy_maxrl@0d6bba6); keep
+    reward_scaling/reward_shaping disabled and KL loss-side.
+
+    normalize_rewards is honored for reference parity: when False, raw rewards are
+    returned (maxRL off), matching the reference's rewards_normalization gate.
+    """
+
+    VARIANTS = ("maxrl", "maxrl_offpolicy")
+
+    def __init__(self, estimator_config: dict, loss_config: dict):
+        self.variant = estimator_config["name"]
+        if self.variant not in self.VARIANTS:
+            raise ValueError(
+                f"MaxRLAdvantageEstimator: unsupported name {self.variant!r}; "
+                f"expected one of {self.VARIANTS}"
+            )
+        self.eps = float(estimator_config.get("maxrl_eps", 1e-6))
+        if self.eps < 0:
+            raise ValueError(f"maxrl_eps must be non-negative, got {self.eps}")
+        self.normalize_rewards = bool(estimator_config.get("normalize_rewards", True))
+        # Optional advantage ceiling. The no-baseline off-policy form divides a
+        # raw reward by a small group mean, so a lone success in a group of 32
+        # is amplified up to 32x; clipping bounds that amplification without
+        # touching the zero/negative side. None disables (historical behavior).
+        clip = estimator_config.get("maxrl_clip")
+        self.clip = None if clip is None else float(clip)
+        if self.clip is not None and self.clip <= 0:
+            raise ValueError(f"maxrl_clip must be positive, got {self.clip}")
+
+    def compute_advantage(self, prompt_ids, rewards, mask, **kwargs):
+        """Compute token-level maxRL advantages.
+
+        Args:
+            prompt_ids: Tensor [batch_size] (or [batch, seq]) identifying which prompt
+                each sample belongs to; samples sharing a prompt form a group. Groups
+                should have >= 2 rollouts (num_generations_per_prompt >= 2) for a
+                meaningful signal.
+            rewards: Tensor [batch_size] of per-sample raw rewards.
+            mask: Response token mask [batch, seq]; used to broadcast the per-sample
+                advantage to token shape.
+
+        Returns:
+            Advantages tensor of shape ``mask.shape``.
+        """
+        if not self.normalize_rewards:
+            # Gate off -> raw rewards as advantage (reference's non-normalized fall-through).
+            return rewards.unsqueeze(-1).expand(mask.shape)
+
+        # Full group mean (NOT leave-one-out): valid_mask = ones (all rollouts count).
+        mean, _ = calculate_baseline_and_std_per_prompt(
+            prompt_ids,
+            rewards,
+            torch.ones_like(rewards),
+            leave_one_out_baseline=False,
+        )
+
+        if self.variant == "maxrl_offpolicy":
+            numerator = rewards
+        else:
+            numerator = rewards - mean
+
+        advantages = numerator / (mean + self.eps)
+        if self.clip is not None:
+            advantages = advantages.clamp(max=self.clip)
+        advantages = advantages.unsqueeze(-1)
+        return advantages.expand(mask.shape)
