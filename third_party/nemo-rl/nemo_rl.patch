+def apply_logprob_support_mask(
+    train_data: BatchedDataDict,
+    logprob_output: BatchedDataDict,
+) -> dict[str, float]:
+    """Propagate filtered-policy support into the rollout training mask."""
+    train_data["prev_logprobs"] = logprob_output["logprobs"]
+    support_mask = logprob_output["logprob_support_mask"].bool()
+    token_mask = train_data["token_mask"]
+    if support_mask.shape != token_mask.shape:
+        raise ValueError(
+            "logprob support mask shape does not match token mask: "
+            f"{support_mask.shape=} != {token_mask.shape=}"
+        )
+
+    valid_mask = token_mask.bool() & train_data["sample_mask"].bool().unsqueeze(-1)
+    mismatch_count = (valid_mask & ~support_mask).sum().item()
+    valid_count = valid_mask.sum().item()
+    train_data["token_mask"] = token_mask * support_mask.to(token_mask.dtype)
+    return {
+        "prev_logprob_support_mismatch_tokens": float(mismatch_count),
+        "prev_logprob_support_mismatch_rate": mismatch_count / max(valid_count, 1),
+    }
