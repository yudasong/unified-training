# Shared settings of every unified math-RL run (Math12K, 0.76B base model)
# Usage: scripts/train_unified.sh experiments/realworld/configs/common.env experiments/realworld/configs/<id>.env
# Paths: CKPT_DIR (base model at $CKPT_DIR/realworld/base), DATA_DIR (experiments/realworld/prepare outputs).
# Recency window 8 = the newest round of each of the paper's 8 generator GPUs.
UNIFIED_ADAM_BETA2=0.999
UNIFIED_CHUNK=128
UNIFIED_DROP_TRUNCATED=0
UNIFIED_EMIT_ZERO_WEIGHT=1
UNIFIED_EVAL_INTERVAL=200
UNIFIED_EVAL_MILESTONE_INTERVAL=1000
UNIFIED_G=16
UNIFIED_GBS=512
UNIFIED_GRAD_CLIP=1.0
UNIFIED_KEEP_POLICIES=2
UNIFIED_LOSS_NORM=response_tokens
UNIFIED_LR=1e-6
UNIFIED_MAXRL_BASELINE=0
UNIFIED_MAX_MODEL_LEN=2048
UNIFIED_MAX_POLICY_AGE_STEPS=4
UNIFIED_MAX_TOKENS=1024
UNIFIED_MBS=2
UNIFIED_MIDTRAIN_VAL_DIR="${DATA_DIR}/realworld/midtrain-val-holdout"
UNIFIED_MIX_RECALC=launch
UNIFIED_NORMALIZE_WEIGHTS=0
UNIFIED_POLICY_HF="${CKPT_DIR}/realworld/base"
UNIFIED_PROMPTS_JSON="${DATA_DIR}/math12k/math12k_verlbox_unified_train.json"
UNIFIED_PROMPT_TEMPLATE=chatml
UNIFIED_PUBLISH_INTERVAL=4
UNIFIED_RECENCY_WINDOW=8
UNIFIED_REQUIRE_EOS=0
UNIFIED_RESCAN_EVERY=512
UNIFIED_REWARD_MODE=verl_box
UNIFIED_SAVE_INTERVAL=64
UNIFIED_SEQ=2048
UNIFIED_SPLIT_SEED=1234
UNIFIED_STREAMING=1
UNIFIED_TEMP=1.0
UNIFIED_TOP_K=50
UNIFIED_TOP_P=0.95
UNIFIED_TRAIN_ITERS=12000
UNIFIED_WARMUP_ITERS=0
UNIFIED_WD=0
UNIFIED_WITHOUT_REPLACEMENT=1
UNIFIED_WMAX=1000000000
