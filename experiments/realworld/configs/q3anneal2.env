# midtraining data decays linearly from 2% to 0 at three quarters of training
UNIFIED_ANCHOR_ADD_BASIS=tokens
UNIFIED_ANCHOR_DIRS="${DATA_DIR}/realworld/midtrain-240m"
UNIFIED_ANCHOR_LOSS=pooled
UNIFIED_ANCHOR_MODE=add
UNIFIED_ANCHOR_TOKEN_FRACTION=0
UNIFIED_EASY_KEEP_FRAC=0
UNIFIED_HARD_FILTER=0
UNIFIED_KL_COEF=0
UNIFIED_MAX_ANCHOR_ROW_FRACTION=0.0360627
UNIFIED_MAX_GROUP_ACC=1.1
UNIFIED_MIX_BASIS=response_tokens
UNIFIED_REQUIRE_NO_ANCHOR_REPLAY=0
UNIFIED_STREAMS_JSON="[{\"dirs\":[\"${UNIFIED_ANCHOR_DIRS}\"],\"token_fraction\":{\"start\":0.02,\"end\":0.0,\"end_progress\":0.75}}]"
