# Settings shared by every RL run of the controlled setting, copied from the runs' launch settings.
# Sourced first; later files add the setting, init, midtraining mix, loss recipe and seed.
NLTW=${NL_TOWER_WORKDIR:-${DATA_DIR}/nl_tower}
# task: raw "question\n\nAnswer: " prompts, exact-assignment reward, a response without EOS gets reward 0
UNIFIED_PROMPT_TEMPLATE=raw
UNIFIED_REWARD_MODE=nl_tower
UNIFIED_REQUIRE_EOS=1
# 32 prompts x 16 generations = 512 RL responses per update; 1,280 response tokens in a 2,048 context
UNIFIED_G=16
UNIFIED_GBS=512
UNIFIED_CHUNK=8
UNIFIED_MBS=8
UNIFIED_MAX_TOKENS=1280
UNIFIED_MAX_MODEL_LEN=2048
UNIFIED_SEQ=2048
UNIFIED_TEMP=1.0
UNIFIED_TOP_K=-1
UNIFIED_TOP_P=1.0
# optimizer: AdamW (0.9, 0.999), lr 1e-5 constant, no warmup, weight decay 0.01, clip 1.0
UNIFIED_LR=1e-5
UNIFIED_WARMUP_ITERS=0
UNIFIED_WD=0.01
UNIFIED_ADAM_BETA2=0.999
UNIFIED_GRAD_CLIP=1.0
# MaxRL: weight 1/p_hat on correct responses, 0 otherwise, no baseline; all groups kept; token mean over all
# response tokens (zero-weight responses included); no KL, no filters
UNIFIED_MAXRL_BASELINE=0
UNIFIED_MAXRL_EPS=1e-6
UNIFIED_LOSS_NORM=response_tokens
UNIFIED_EMIT_ZERO_WEIGHT=1
UNIFIED_KEEP_ALLCORRECT=1
UNIFIED_MAX_GROUP_ACC=1.1
UNIFIED_DROP_ALL_WRONG=0
UNIFIED_DROP_TRUNCATED=0
UNIFIED_NORMALIZE_WEIGHTS=0
UNIFIED_HARD_FILTER=0
UNIFIED_WMAX=1000000000
UNIFIED_KL_COEF=0
# on-policy: a new policy every update, responses at most one update old
UNIFIED_STRICT_POLICY_AGE=1
UNIFIED_MAX_POLICY_AGE_STEPS=1
UNIFIED_PUBLISH_INTERVAL=1
UNIFIED_RECENCY_WINDOW=4
UNIFIED_STREAMING=1
UNIFIED_WITHOUT_REPLACEMENT=1
UNIFIED_RESCAN_EVERY=512
UNIFIED_ROLLOUT_WAIT_TIMEOUT_SECONDS=1800
UNIFIED_ROLLOUT_POLL_SECONDS=1
# checkpoints (milestone exports every 250 updates are what the evaluations read) and the token logs (every 10
# updates) that the compute estimates use
UNIFIED_SAVE_INTERVAL=50
UNIFIED_EVAL_MILESTONE_INTERVAL=250
UNIFIED_LOG_INTERVAL=10
UNIFIED_LOG_LOSS_TOKENS=1
