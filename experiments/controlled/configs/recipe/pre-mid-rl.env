# pre+mid+RL: unified training + pretraining text, 4 extra rows per update, ~10% of the midtraining tokens
# (rows from data.sh pretrain-rows, one round per midtraining count), same token-mean loss
UNIFIED_ANCHOR_LOSS=pooled
UNIFIED_PRETRAIN_DIRS=${NLTW}/unified_data/anchors/pretrain_tw1X_p10_m${NLTW_DEMO_ROWS}
UNIFIED_PRETRAIN_ROWS_PER_STEP=4
