# 64 midtraining examples per update, appended to the 512 RL responses (fraction 64/512 of rows, basis "rows")
NLTW_DEMO_ROWS=64
UNIFIED_ANCHOR_DIRS=${NLTW}/unified_data/anchors/demos_tw1X_resp
UNIFIED_ANCHOR_MODE=add
UNIFIED_ANCHOR_ADD_BASIS=rows
UNIFIED_ANCHOR_TOKEN_FRACTION=0.125
UNIFIED_MIX_RECALC=launch
UNIFIED_MIX_BASIS=response_tokens
UNIFIED_REQUIRE_NO_ANCHOR_REPLAY=0
UNIFIED_MAX_ANCHOR_ROW_FRACTION=1.0
